---
/**
 * Footer — Experimental Jetset
 * Ruled index grid, structural metadata
 */

const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer__index">
    <div class="footer__item">
      <span class="footer__label">Name</span>
      <span class="footer__value">Muhammad Arifin</span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Brand</span>
      <span class="footer__value">Arifin.</span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Role</span>
      <span class="footer__value">Information Systems Undergraduate</span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Stack</span>
      <span class="footer__value">Arch · Hyprland · Kitty · Fish · VSCodium</span>
    </div>
    <div class="footer__item">
      <span class="footer__label">GitHub</span>
      <span class="footer__value"><a href="https://github.com/HyuraFE" target="_blank" rel="noopener noreferrer">github.com/HyuraFE</a></span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Email</span>
      <span class="footer__value"><a href="mailto:notohyura@gmail.com">notohyura@gmail.com</a></span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Dotfiles</span>
      <span class="footer__value"><a href="https://github.com/HyuraFE/dotfiles" target="_blank" rel="noopener noreferrer">github.com/HyuraFE/dotfiles</a></span>
    </div>
    <div class="footer__item">
      <span class="footer__label">Projects</span>
      <span class="footer__value">4 live utilities</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-surface-contrast);
    color: var(--color-text-on-contrast);
  }

  .footer__index {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--line-thin);
  }

  @media (max-width: 1024px) {
    .footer__index {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .footer__index {
      grid-template-columns: 1fr;
    }
  }

  .footer__item {
    padding: var(--gap);
    border-right: var(--line-thin) solid var(--color-line);
    border-bottom: var(--line-thin) solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer__item:nth-child(4n) {
    border-right: none;
  }

  .footer__item:nth-child(n+5) {
    border-bottom: none;
  }

  @media (max-width: 1024px) {
    .footer__item:nth-child(4n) {
      border-right: var(--line-thin) solid var(--color-line);
    }
    .footer__item:nth-child(2n) {
      border-right: none;
    }
    .footer__item:nth-child(n+3) {
      border-bottom: none;
    }
    .footer__item:nth-child(n+5) {
      border-bottom: var(--line-thin) solid var(--color-line);
    }
  }

  @media (max-width: 768px) {
    .footer__item:nth-child(2n) {
      border-right: var(--line-thin) solid var(--color-line);
    }
    .footer__item {
      border-right: none;
      border-bottom: var(--line-thin) solid var(--color-line);
    }
    .footer__item:last-child {
      border-bottom: none;
    }
  }

  .footer__label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-amber);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer__value {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .footer__value {
      font-size: 14px;
    }
  }

  .footer__value a {
    color: var(--color-blue);
  }

  .footer__value a:hover,
  .footer__value a:focus {
    color: var(--color-amber);
  }
</style>