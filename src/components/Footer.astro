---
/**
 * Footer - Minimalis
 * Copyright + social links (GitHub, LinkedIn, Email)
 */

const socials = [
  {
    name: "GitHub",
    url: "https://github.com/HyuraFE",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="currentColor" d="M208.31 75.68A59.78 59.78 0 0 0 202.93 28a8 8 0 0 0-6.93-4a59.75 59.75 0 0 0-48 24h-24a59.75 59.75 0 0 0-48-24a8 8 0 0 0-6.93 4a59.78 59.78 0 0 0-5.38 47.68A58.14 58.14 0 0 0 56 104v8a56.06 56.06 0 0 0 48.44 55.47A39.8 39.8 0 0 0 96 192v8H72a24 24 0 0 1-24-24a40 40 0 0 0-40-40a8 8 0 0 0 0 16a24 24 0 0 1 24 24a40 40 0 0 0 40 40h24v16a8 8 0 0 0 16 0v-40a24 24 0 0 1 48 0v40a8 8 0 0 0 16 0v-40a39.8 39.8 0 0 0-8.44-24.53A56.06 56.06 0 0 0 216 112v-8a58.14 58.14 0 0 0-7.69-28.32Z"/></svg>`,
  },
  {
    name: "Email",
    url: "mailto:notohyura@gmail.com",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256"><path fill="currentColor" d="M224 48H32a8 8 0 0 0-8 8v136a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a8 8 0 0 0-8-8Zm-96 85.15L52.57 64h150.86ZM98.71 128L40 181.81V74.19Zm11.84 10.85l12 11.05a8 8 0 0 0 10.82 0l12.09-11.05L203.43 192H52.57ZM157.29 128L216 74.18v107.64Z"/></svg>`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="px-4 sm:px-6 pb-6" id="kontak">
  <div
    class="glass mx-auto max-w-6xl rounded-2xl px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4"
  >
    <p class="text-sm text-shuukura-900/70 font-body">
      &copy; {currentYear} Muhammad Arifin. Built with Astro.
    </p>

    <div class="flex items-center gap-2">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="flex h-11 w-11 items-center justify-center rounded-xl text-shuukura-600 hover:text-shuukura-900 hover:bg-white/60 transition-colors"
          >
            <Fragment set:html={social.icon} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
