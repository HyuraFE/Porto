---
/**
 * Fun Facts — Experimental Jetset
 * Debug notes grid, authentic stories from brand-spec.md
 */

const funFacts = [
  {
    title: "Pertama coding pakai Notepad",
    description:
      "Awal belajar HTML dan CSS langsung di Notepad tanpa IDE, tanpa syntax highlighting. Hasilnya halaman putih polos karena lupa tag body.",
  },
  {
    title: "Bug terlama: 6 jam karena typo",
    description:
      "Pernah debugging selama 6 jam hanya karena typo di nama variabel. Sejak itu selalu pakai IDE dengan autocomplete.",
  },
  {
    title: "Lebih sering googling daripada coding",
    description:
      "Stack Overflow dan Google adalah sahabat terbaik. Kemampuan mencari solusi lebih penting daripada menghafal semua syntax.",
  },
];
---

<section id="catatan" class="section" aria-labelledby="facts-title">
  <header class="section__header">
    <h2 id="facts-title" class="section__title">Catatan Debug</h2>
    <span class="section__count">3 ENTRI</span>
  </header>
  <div class="section__body">
    <div class="facts__grid">
      {
        funFacts.map((fact) => (
          <article class="fact-card">
            <h3 class="fact-card__title">{fact.title}</h3>
            <p class="fact-card__text">{fact.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--gap);
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-white);
  }

  .section__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--gap);
    padding: var(--gap);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .section__header {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
      padding: var(--gap-sm);
    }
  }

  .section__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(18px, 2.5vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .section__count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-amber);
    padding: 4px 10px;
    border: var(--line-thin) solid var(--color-amber);
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .section__body {
    padding: var(--gap);
  }

  @media (max-width: 768px) {
    .section__body {
      padding: var(--gap-sm);
    }
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--line-thin);
  }

  @media (max-width: 1024px) {
    .facts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .facts__grid {
      grid-template-columns: 1fr;
    }
  }

  .fact-card {
    padding: var(--gap);
    border-right: var(--line-thin) solid var(--color-line);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-white);
  }

  .fact-card:nth-child(3n) {
    border-right: none;
  }

  .fact-card:last-child {
    border-bottom: none;
  }

  @media (max-width: 1024px) {
    .fact-card:nth-child(3n) {
      border-right: var(--line-thin) solid var(--color-line);
    }
    .fact-card:nth-child(2n) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .fact-card {
      border-right: none;
      border-bottom: var(--line-thin) solid var(--color-line);
    }
    .fact-card:last-child {
      border-bottom: none;
    }
  }

  .fact-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-black);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  @media (max-width: 768px) {
    .fact-card__title {
      font-size: 16px;
    }
  }

  .fact-card__text {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .fact-card__text {
      font-size: 14px;
    }
  }
</style>