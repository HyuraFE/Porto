---
/**
 * Hero / Blueprint Grid — Experimental Jetset
 * Grayscale contrast portrait + bold declarative statement + direct action
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__panel hero__panel--portrait">
    <picture>
      <source srcset="/images/profile.webp" type="image/webp" />
      <img
        src="/images/profile.png"
        alt="Foto profil Muhammad Arifin"
        class="hero__portrait"
        loading="eager"
        fetchpriority="high"
        width="288"
        height="384"
      />
    </picture>
  </div>
  <div class="hero__panel hero__panel--text">
    <h2 id="hero-title" class="hero__tagline">
      Practical builder. Tool maker. Daily Linux driver.
    </h2>
    <p class="hero__persona">
      Arch + Hyprland. Code as proof of capability. Four live utilities, zero bloat.
    </p>
    <a href="#proyek" class="hero__cta">
      View Projects →
    </a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    margin-bottom: var(--gap);
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-surface);
  }

  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero {
      gap: var(--gap-sm);
    }
  }

  .hero__panel {
    padding: var(--gap);
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .hero__panel {
      padding: var(--gap-sm);
    }
  }

  .hero__panel--portrait {
    border-right: var(--line-thin) solid var(--color-line);
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .hero__panel--portrait {
      border-right: none;
      border-bottom: var(--line-thin) solid var(--color-line);
    }
  }

  .hero__portrait {
    width: 100%;
    max-width: 288px;
    aspect-ratio: 3/4;
    object-fit: cover;
    border: var(--line-thick) solid var(--color-line);
  }

  .hero__panel--text {
    justify-content: center;
    gap: var(--gap-sm);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(20px, 3vw, 32px);
    line-height: 1.2;
    color: var(--color-text);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__persona {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .hero__persona {
      font-size: 16px;
    }
  }

  .hero__cta {
    margin-top: var(--gap-sm);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 10px 16px;
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-surface-contrast);
    color: var(--color-text-on-contrast);
    text-decoration: none;
    min-height: 44px;
    align-self: flex-start;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .hero__cta:hover,
  .hero__cta:focus {
    background: var(--color-blue);
    color: var(--color-text-on-contrast);
    border-color: var(--color-blue);
    text-decoration: none;
  }
</style>
