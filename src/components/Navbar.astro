---
/**
 * Header / Titlebar — Experimental Jetset
 * Name headline + role meta + raw ruled action links
 */
---

<header class="titlebar" role="banner">
  <div class="titlebar__brand">
    <h1 class="titlebar__name">Arifin.</h1>
    <p class="titlebar__role">Information Systems Undergraduate</p>
  </div>
  <nav class="titlebar__socials" aria-label="Social links">
    <a href="https://github.com/HyuraFE" class="titlebar__link" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <a href="mailto:notohyura@gmail.com" class="titlebar__link">Email ✉</a>
  </nav>
</header>

<style>
  .titlebar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--gap);
    padding-bottom: var(--gap);
    border-bottom: var(--line-thick) solid var(--color-line);
    margin-bottom: var(--gap);
  }

  @media (max-width: 768px) {
    .titlebar {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
    }
  }

  .titlebar__brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .titlebar__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    color: var(--color-black);
    letter-spacing: -0.02em;
  }

  .titlebar__role {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .titlebar__role {
      font-size: 11px;
    }
  }

  .titlebar__socials {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: end;
  }

  @media (max-width: 768px) {
    .titlebar__socials {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      width: 100%;
    }
  }

  .titlebar__link {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    padding: 8px 12px;
    border: var(--line-thin) solid var(--color-line);
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-black);
    background: transparent;
  }

  .titlebar__link:hover,
  .titlebar__link:focus {
    background: var(--color-black);
    color: var(--color-white);
    text-decoration: none;
    border-color: var(--color-black);
  }
</style>
