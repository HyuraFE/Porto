---
/**
 * Header / Titlebar — Experimental Jetset
 * Name headline + role meta + raw ruled action links + Theme Toggle
 */
---

<header class="titlebar" role="banner">
  <div class="titlebar__brand">
    <h1 class="titlebar__name">Arifin.</h1>
    <p class="titlebar__role">Information Systems Undergraduate</p>
  </div>
  <div class="titlebar__actions">
    <button
      id="theme-toggle"
      class="titlebar__link theme-toggle-btn"
      type="button"
      aria-label="Toggle dark/light theme"
      title="Toggle theme (Light / Dark / System)"
    >
      <span class="theme-icon theme-icon--light" aria-hidden="true">☀</span>
      <span class="theme-icon theme-icon--dark" aria-hidden="true">☾</span>
      <span class="theme-label" id="theme-status">THEME</span>
    </button>
    <nav class="titlebar__socials" aria-label="Social links">
      <a href="https://github.com/HyuraFE" class="titlebar__link" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="mailto:notohyura@gmail.com" class="titlebar__link">Email ✉</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-status');
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    function updateLabel(theme) {
      if (!label) return;
      label.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    updateLabel(currentTheme);

    if (btn) {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const next = isDark ? 'light' : 'dark';
        if (next === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        localStorage.setItem('theme', next);
        updateLabel(next);
      });
    }

    media.addEventListener('change', (e) => {
      if (!localStorage.getItem('theme')) {
        if (e.matches) {
          document.documentElement.classList.add('dark');
          updateLabel('dark');
        } else {
          document.documentElement.classList.remove('dark');
          updateLabel('light');
        }
      }
    });
  })();
</script>

<style>
  .titlebar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--gap);
    padding-bottom: var(--gap);
    border-bottom: var(--line-thick) solid var(--color-line);
    margin-bottom: var(--gap);
  }

  @media (max-width: 768px) {
    .titlebar {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
    }
  }

  .titlebar__brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .titlebar__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .titlebar__role {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .titlebar__role {
      font-size: 11px;
    }
  }

  .titlebar__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .titlebar__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      width: 100%;
    }
  }

  .titlebar__socials {
    display: flex;
    gap: 8px;
  }

  .titlebar__link {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    padding: 8px 12px;
    border: var(--line-thin) solid var(--color-line);
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
    box-sizing: border-box;
  }

  .titlebar__link:hover,
  .titlebar__link:focus {
    background: var(--color-surface-contrast);
    color: var(--color-text-on-contrast);
    text-decoration: none;
    border-color: var(--color-line);
  }

  .theme-toggle-btn {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(html.dark) .theme-icon--light {
    display: none;
  }
  :global(html.dark) .theme-icon--dark {
    display: inline;
  }
  :global(html:not(.dark)) .theme-icon--light {
    display: inline;
  }
  :global(html:not(.dark)) .theme-icon--dark {
    display: none;
  }
</style>
