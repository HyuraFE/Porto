---
/**
 * Projects Section — Experimental Jetset
 * Modular 4-cell grid, ruled borders, raw domain links
 * Data sourced from brand-spec.md (authentic copy, no embellishment)
 */

const projects = [
  {
    name: "TikTok Videos Downloader",
    description: "Tempat mengunduh video TikTok tanpa adanya watermark.",
    url: "https://tik.pylexia.fun",
  },
  {
    name: "Shrtnr",
    description: "Meringkas link website seperti Bitly.",
    url: "https://sh.pylexia.fun",
  },
  {
    name: "Chatbot AI",
    description: "Agent AI bot sederhana dengan model Gemini dan ChatGPT.",
    url: "https://bot.pylexia.fun",
  },
  {
    name: "Manga Tracker",
    description: "Tempat untuk mengawasi bacaan Manga atau Light Novel.",
    url: "https://ani.pylexia.fun",
  },
];
---

<section id="proyek" class="section" aria-labelledby="projects-title">
  <header class="section__header">
    <h2 id="projects-title" class="section__title">Proyek</h2>
    <span class="section__count">4 LIVE</span>
  </header>
  <div class="section__body">
    <div class="projects__grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <h3 class="project-card__title">{project.name}</h3>
            <p class="project-card__desc">{project.description}</p>
            <a
              href={project.url}
              class="project-card__link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.url.replace("https://", "")}
              <span class="sr-only"> (buka di tab baru)</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--gap);
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-white);
  }

  .section__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--gap);
    padding: var(--gap);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-black);
    color: var(--color-white);
  }

  @media (max-width: 768px) {
    .section__header {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
      padding: var(--gap-sm);
    }
  }

  .section__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(18px, 2.5vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .section__count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-amber);
    padding: 4px 10px;
    border: var(--line-thin) solid var(--color-amber);
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .section__body {
    padding: var(--gap);
  }

  @media (max-width: 768px) {
    .section__body {
      padding: var(--gap-sm);
    }
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--line-thin);
  }

  @media (max-width: 1024px) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: var(--gap);
    border-right: var(--line-thin) solid var(--color-line);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-white);
    transition: background 0.15s ease;
  }

  .project-card:nth-child(4n) {
    border-right: none;
  }

  .project-card:last-child {
    border-bottom: none;
  }

  @media (max-width: 1024px) {
    .project-card:nth-child(4n) {
      border-right: var(--line-thin) solid var(--color-line);
    }
    .project-card:nth-child(2n) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .project-card:nth-child(2n) {
      border-right: none;
    }
    .project-card {
      border-right: none;
      border-bottom: var(--line-thin) solid var(--color-line);
    }
    .project-card:last-child {
      border-bottom: none;
    }
  }

  .project-card:hover {
    background: #F5F5F5;
  }

  .project-card__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-black);
    letter-spacing: -0.01em;
    margin-bottom: var(--gap-sm);
  }

  @media (max-width: 768px) {
    .project-card__title {
      font-size: 16px;
    }
  }

  .project-card__desc {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex: 1;
    margin-bottom: var(--gap-sm);
    text-wrap: pretty;
  }

  @media (max-width: 768px) {
    .project-card__desc {
      font-size: 14px;
    }
  }

  .project-card__link {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    align-self: flex-start;
    padding: 6px 10px;
    border: var(--line-thin) solid var(--color-line);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .project-card__link:hover,
  .project-card__link:focus {
    background: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
    text-decoration: none;
  }
</style>
