---
/**
 * Projects Section - Grid 2x3 project showcase
 * Setiap card bisa diklik untuk navigasi ke URL project
 * Data project disimpan di array agar mudah diedit
 */

const projects = [
  {
    name: "Project Alpha",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
  {
    name: "Project Beta",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
  {
    name: "Project Gamma",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
  {
    name: "Project Delta",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
  {
    name: "Project Epsilon",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
  {
    name: "Project Zeta",
    description: "Deskripsi singkat tentang project ini",
    url: "#",
  },
];
---

<section class="py-20 md:py-28" id="projects">
  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="text-3xl md:text-4xl font-bold font-display text-shuukura-900 text-center mb-14"
    >
      Projects
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project, i) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`group flex items-center justify-between rounded-xl border border-shuukura-200 
            bg-white p-6 
            hover:shadow-lg hover:shadow-shuukura-500/8 hover:-translate-y-1 hover:border-shuukura-300
            transition-all duration-300 ease-out
            animate-fade-in-up animate-delay-${(i + 1) * 100}`}
          >
            <div>
              <h3 class="text-lg font-semibold font-display text-shuukura-900 group-hover:text-shuukura-500 transition-colors">
                {project.name}
              </h3>
              <p class="text-sm text-shuukura-900/50 font-body mt-1">
                {project.description}
              </p>
            </div>

            {/* Arrow icon - Phosphor ArrowSquareOut style */}
            <div class="ml-4 flex-shrink-0 text-shuukura-400 group-hover:text-shuukura-500 transition-colors">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 256 256"
              >
                <path
                  fill="currentColor"
                  d="M224 104a8 8 0 0 1-16 0V59.32l-66.33 66.34a8 8 0 0 1-11.32-11.32L196.68 48H152a8 8 0 0 1 0-16h64a8 8 0 0 1 8 8Zm-40 24a8 8 0 0 0-8 8v72H48V80h72a8 8 0 0 0 0-16H48a16 16 0 0 0-16 16v128a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16v-72a8 8 0 0 0-8-8Z"
                />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
