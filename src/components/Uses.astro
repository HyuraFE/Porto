---
/**
 * Uses / Environment — Experimental Jetset
 * Ruled metadata table, dotfiles link
 * Data sourced from brand-spec.md
 */

const hardware = {
  hardware: "Asus Vivobook Go 14",
  os: "Arch Linux (Rolling Release)",
  wm: "Hyprland (Wayland)",
  terminal: "Kitty (GPU-accelerated)",
  shell: "Fish Shell",
  editor: "VSCodium (Open Source)",
};

const dotfilesUrl = "https://github.com/HyuraFE/dotfiles";
---

<section id="setup" class="section" aria-labelledby="uses-title">
  <header class="section__header">
    <h2 id="uses-title" class="section__title">Setup / Lingkungan</h2>
    <span class="section__count">6 ITEMS</span>
  </header>
  <div class="section__body">
    <div class="uses__table">
      <div class="uses__row">
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">Hardware</span>
            <span class="uses__value">{hardware.hardware}</span>
          </div>
        </div>
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">OS</span>
            <span class="uses__value">{hardware.os}</span>
          </div>
        </div>
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">WM / Compositor</span>
            <span class="uses__value">{hardware.wm}</span>
          </div>
        </div>
      </div>
      <div class="uses__row">
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">Terminal</span>
            <span class="uses__value">{hardware.terminal}</span>
          </div>
        </div>
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">Shell</span>
            <span class="uses__value">{hardware.shell}</span>
          </div>
        </div>
        <div class="uses__cell">
          <div class="uses__item">
            <span class="uses__label">Editor</span>
            <span class="uses__value">{hardware.editor}</span>
          </div>
        </div>
      </div>
      <div class="uses__row">
        <div class="uses__cell uses__cell--dotfiles" style="grid-column: 1 / -1;">
          <a
            href={dotfilesUrl}
            class="uses__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Dotfiles Repository
            <span class="sr-only">(buka di tab baru)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--gap);
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-surface);
  }

  .section__header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--gap);
    padding: var(--gap);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-surface-contrast);
    color: var(--color-text-on-contrast);
  }

  @media (max-width: 768px) {
    .section__header {
      grid-template-columns: 1fr;
      gap: var(--gap-sm);
      padding: var(--gap-sm);
    }
  }

  .section__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(18px, 2.5vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .section__count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-amber);
    padding: 4px 10px;
    border: var(--line-thin) solid var(--color-amber);
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .section__body {
    padding: var(--gap);
  }

  @media (max-width: 768px) {
    .section__body {
      padding: var(--gap-sm);
    }
  }

  .uses__table {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--line-thin);
  }

  @media (max-width: 1024px) {
    .uses__table {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .uses__table {
      grid-template-columns: 1fr;
    }
  }

  .uses__row {
    display: contents;
  }

  .uses__cell {
    padding: var(--gap);
    border-right: var(--line-thin) solid var(--color-line);
    border-bottom: var(--line-thin) solid var(--color-line);
    background: var(--color-surface);
  }

  .uses__cell:nth-child(3n) {
    border-right: none;
  }

  @media (max-width: 1024px) {
    .uses__cell:nth-child(3n) {
      border-right: var(--line-thin) solid var(--color-line);
    }
    .uses__cell:nth-child(2n) {
      border-right: none;
    }
  }

  @media (max-width: 768px) {
    .uses__cell {
      border-right: none;
      border-bottom: var(--line-thin) solid var(--color-line);
    }
    .uses__cell:last-child {
      border-bottom: none;
    }
  }

  .uses__cell--dotfiles {
    border-right: none;
    border-bottom: none;
    padding: var(--gap) 0;
  }

  .uses__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .uses__label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-amber);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .uses__value {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .uses__value {
      font-size: 14px;
    }
  }

  .uses__link {
    font-family: var(--font-mono);
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: var(--line-thick) solid var(--color-line);
    background: var(--color-surface-contrast);
    color: var(--color-text-on-contrast);
    text-decoration: none;
    min-height: 44px;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .uses__link:hover,
  .uses__link:focus {
    background: var(--color-blue);
    color: var(--color-text-on-contrast);
    border-color: var(--color-blue);
    text-decoration: none;
  }
</style>